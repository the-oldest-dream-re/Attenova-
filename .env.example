# Server Port (Render sets PORT automatically)
PORT=3000

# Secret key used to sign JWT session tokens
JWT_SECRET=attendly-super-secret-jwt-key-change-in-production

# Google OAuth 2.0 Web Client ID (from https://console.cloud.google.com/apis/credentials)
# Leave blank or replace with your actual Client ID (.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# Institutional Admin Email Domain or Specific Admin Emails (comma-separated)
ADMIN_EMAILS=admin@college.edu,principal@college.edu
